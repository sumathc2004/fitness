# ───────── Database ─────────
DB_ROOT_PASSWORD=gym_root_dev
DB_NAME=gym_platform
DB_USER=gym
DB_PASSWORD=gym_dev_password
DATABASE_URL="mysql://gym:gym_dev_password@localhost:3307/gym_platform"

# ───────── API ─────────
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3100
NODE_ENV=development

# Generate strong, different secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=30
COOKIE_SECURE=false

# First Super Admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=Gym Owner

# Dev-only demo accounts (npm run db:seed:demo)
SEED_DEMO_USERNAME=
SEED_DEMO_PASSWORD=Demo@12345!

# ───────── Email (optional) ─────────
# When SMTP_HOST is empty, emails (e.g. password reset links) are written to the API log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gym Platform <no-reply@gym.local>"

# ───────── Storage (Phase 2+; optional) ─────────
# STORAGE_PROVIDER=cloudinary | s3 | local
STORAGE_PROVIDER=local
CLOUDINARY_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Shared secret for door/QR hardware posting to /api/attendance/device-scan (leave empty to disable)
DEVICE_API_KEY=
